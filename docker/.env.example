# Required. Compose refuses to start when any of these is empty.
# POSTGRES_USER is the role AnyGridDB signs in as: it owns the database
# and is no superuser. Any name but postgres, the cluster's own.
# POSTGRES_PASSWORD goes into the database's address as it is written
# here: letters and digits, as `openssl rand -hex 24` gives. A "/", "?",
# "#" or "%" in it would be read as part of the address, and AnyGridDB
# would not start.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 32 bytes, base64. Generate with: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=
# Only while the key is being changed (docs/operations.md): the earlier
# keys, as id:base64 separated by commas. The key above, given without an
# identifier, is named 0.
# AUTH_ENCRYPTION_PREVIOUS_KEYS=
# Only with the S3 overlay (compose.s3.yml).
# RUSTFS_ACCESS_KEY=
# RUSTFS_SECRET_KEY=
# S3_BUCKET=attachments
# S3_SERVER_SIDE_ENCRYPTION=
# S3_KMS_KEY_ID=
# Or files in an object store of your own, without the overlay: an HTTPS
# address, its keys and bucket, and the two settings above if it encrypts.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# Optional. Hosts where administrators may declare client databases
# (sources): names, *.domains, IP addresses, CIDR ranges. Empty allows none.
ANYGRIDDB_SOURCES_ALLOWED_HOSTS=
# Optional. Absolute directory prefixes where SQLite source files may live.
# Comma- or colon-separated. Empty allows none. TLS does not apply to SQLite.
ANYGRIDDB_SOURCES_ALLOWED_PATHS=
# Optional. Development only: allow SQLite :memory: sources in tests.
# ANYGRIDDB_SOURCES_SQLITE_ALLOW_MEMORY=true
# Optional. Reverse proxies allowed to set the client address via
# X-Forwarded-For: comma-separated IP addresses or CIDR ranges, such as
# the proxy's Docker network. Empty ignores the header. With a proxy on
# the same host, also use compose.proxy.yml (docs/operations.md).
# ANYGRIDDB_TRUSTED_PROXIES=172.18.0.0/16
# Optional. Accounts with these emails become instance administrators.
ADMIN_EMAILS=
# Optional. The HTTPS origin people open (default https://localhost:3000):
# links in emails, cookies, API documents, the certificate's primary name,
# and passkeys. Use a hostname (https://grid.example.org,
# https://grid.lan:3000, or https://localhost:3000). An IP alone
# (https://192.168.1.10:3000) keeps HTTPS and TOTP; passkeys need a
# resolvable hostname in PUBLIC_URL (docs/operations.md, ADR 0029).
PUBLIC_URL=
# Optional. Extra names and addresses for the certificate only (SANs),
# comma-separated. Example with passkeys on a LAN hostname:
#   PUBLIC_URL=https://grid.lan:3000
#   TLS_NAMES=192.168.1.10
TLS_NAMES=
# Optional. Your own certificate and key (PEM, the chain in the certificate
# file), mounted into the container at /own-tls (see compose.yml). Without them,
# AnyGridDB makes its own authority: install
# https://<address>/tls/authority.crt once on each workstation, after
# checking its fingerprint (Administration > Health).
TLS_CERT_FILE=
TLS_KEY_FILE=
# Optional. Largest attachment in bytes (default 20 MiB). Set here, it
# holds: Administration shows it and cannot change it. Empty,
# Administration sets it.
ATTACHMENT_MAX_BYTES=
# Optional, for scripts/backup.sh: an age public key (age1…) that encrypts
# each backup file as it is written, and the days backups are kept.
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP_DAYS=
# Optional. Uploads read at once (1 to 64, default 8).
UPLOAD_CONCURRENCY=
