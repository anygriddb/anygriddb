# Required. Compose refuses to start when any of these is empty.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 32 bytes, base64. Generate with: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=
# Only with the S3 overlay (compose.s3.yml).
# RUSTFS_ACCESS_KEY=
# RUSTFS_SECRET_KEY=
# S3_BUCKET=attachments
# S3_SERVER_SIDE_ENCRYPTION=
# S3_KMS_KEY_ID=
# Optional. Hosts where administrators may declare client databases
# (sources): names, *.domains, IP addresses, CIDR ranges. Empty allows none.
ANYGRIDDB_SOURCES_ALLOWED_HOSTS=
# Optional. Reverse proxies allowed to set the client address via
# X-Forwarded-For: comma-separated IP addresses or CIDR ranges, such as
# the proxy's Docker network. Empty ignores the header.
# ANYGRIDDB_TRUSTED_PROXIES=172.18.0.0/16
# Optional. Accounts with these emails become instance administrators.
ADMIN_EMAILS=
# Optional. The HTTPS origin people open (default https://localhost:3000):
# links in emails, cookies, API documents, the certificate's primary name,
# and passkeys. Use a hostname (https://grid.example.org,
# https://grid.lan:3000, or https://localhost:3000). An IP alone
# (https://192.168.1.10:3000) keeps HTTPS and TOTP; passkeys need a
# resolvable hostname in PUBLIC_URL (docs/operations.md, ADR 0029).
PUBLIC_URL=
# Optional. Extra names and addresses for the certificate only (SANs),
# comma-separated. Example with passkeys on a LAN hostname:
#   PUBLIC_URL=https://grid.lan:3000
#   TLS_NAMES=192.168.1.10
TLS_NAMES=
# Optional. Your own certificate and key (PEM, the chain in the certificate
# file), mounted into the container at /own-tls (see compose.yml). Without them,
# AnyGridDB makes its own authority: install
# https://<address>/tls/authority.crt once on each workstation, after
# checking its fingerprint (Administration > Health).
TLS_CERT_FILE=
TLS_KEY_FILE=
# Optional. Largest attachment in bytes (default 20 MiB).
ATTACHMENT_MAX_BYTES=
