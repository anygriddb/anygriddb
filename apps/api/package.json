{
  "name": "@anygriddb/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/trpc/router.ts"
  },
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "cli": "node --env-file-if-exists=../../.env --import tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:samples": "../../scripts/lab/fetch-seeds.sh && vitest run --config vitest.samples.config.ts",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@anygriddb/core": "workspace:*",
    "@anygriddb/db": "workspace:*",
    "@aws-sdk/client-s3": "3.1161.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "@fastify/websocket": "11.3.4",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@node-rs/argon2": "2.2.2",
    "@node-saml/node-saml": "5.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@simplewebauthn/server": "14.0.3",
    "@trpc/server": "11.22.1",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "graphile-worker": "0.18.0",
    "kysely": "0.29.7",
    "mysql2": "3.24.6",
    "nodemailer": "10.3.1",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "sharp": "0.35.5",
    "tedious": "20.3.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anygriddb/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "jose": "6.2.3",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
