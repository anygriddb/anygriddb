# Host dev (`pnpm dev`). Copy to `.env` and fill the secrets.
# DATABASE_URL must point at the Postgres that compose.dev.yml publishes on
# 127.0.0.1:5432.
DATABASE_URL=
# 32 bytes, base64. Generate with: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=
PORT=4000
# The address people open. In development that is Vite's server on this
# machine, which forwards the API's paths to PORT, so the browser sees one
# origin. The API itself serves HTTPS only, with a certificate from the
# instance's own authority in TLS_DIR (ADR 0029). Anywhere else PUBLIC_URL
# is https://.
PUBLIC_URL=http://localhost:3000
# TLS_DIR=./data/tls
# TLS_NAMES=
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# Files (attachments, exports, staged imports) live on disk by default.
# STORAGE_PATH=./data/files
# Or in any S3-compatible service: STORAGE_DRIVER=s3 and the S3_* below.
# An instance with S3_* set and no STORAGE_DRIVER keeps using S3.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=attachments
# Optional. Largest attachment in bytes (default 20 MiB).
ATTACHMENT_MAX_BYTES=
# Optional. Background work per process: events, webhooks, automations, and
# schedules (default 4), and imports, exports, copies, snapshots (default 2).
# WORKER_CONCURRENCY=4
# JOB_CONCURRENCY=2
# Optional. Hosts where administrators may declare client databases
# (sources): names, *.domains, IP addresses, CIDR ranges. Empty allows none.
# ANYGRIDDB_SOURCES_ALLOWED_HOSTS=db.internal,*.corp.example,10.0.0.0/8
# Development only: sources connect without TLS. Never in production.
# ANYGRIDDB_SOURCES_ALLOW_PLAINTEXT=false
# Optional. Accounts with these emails become instance administrators.
# The first account created is always one.
ADMIN_EMAILS=
# Optional. Email for webhooks, automations, and notifications.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Optional. Prometheus metrics on /metrics, for this bearer token only
# (32 characters or more); without it, there are none (ADR 0018).
# METRICS_TOKEN=
# Optional. OpenTelemetry traces to an OTLP/HTTP collector over HTTPS; the
# exporter also reads OTEL_EXPORTER_OTLP_HEADERS. Without it, none.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.internal:4318
# OTEL_SERVICE_NAME=anygriddb
# Optional single sign-on.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=
# SAML_ENTRY_POINT=
# SAML_ISSUER=
# SAML_CERT=
# SAML_CALLBACK_URL=
